# Bot của công cụ tìm kiếm và bộ xem trước link.
#
# Ứng dụng này dựng hoàn toàn bằng JS phía trình duyệt, nên với các bot KHÔNG chạy JS
# (Facebook, Zalo, Telegram, Slack, LinkedIn…) mọi trang hồ sơ `/{slug}` đều chỉ là một
# `<div id="root">` rỗng — link chia sẻ ra ngoài không có tiêu đề lẫn ảnh. Nhận diện được
# bot thì lái sang bản HTML do backend dựng sẵn.
map $http_user_agent $is_bot {
    default 0;
    ~*(googlebot|bingbot|facebookexternalhit|twitterbot|linkedinbot|slackbot|whatsapp|telegrambot) 1;
}

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied expired no-cache no-store private auth;
    # `application/json` là chủ ý, không phải thừa: ảnh đại diện và ảnh bìa của trang công
    # khai lưu dạng data URL base64 NGAY TRONG JSON, mà base64 phình 33% so với nhị phân.
    # Thiếu dòng này thì toàn bộ phần phình đó đi thẳng qua dây ở mọi lượt khách mở trang.
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json;
    gzip_disable "MSIE [1-6]\.";

    location /api/ {
        # Deal attachments (client brief PDFs, scanned contracts) come through
        # here: the built app has no VITE_API_URL, so axios falls back to the
        # same-origin "/api/v1" and every upload is proxied by this block.
        #
        # nginx defaults to 1m. The backend accepts 10m, so without this line
        # anything above 1 MB died on nginx's bare 413 page before FastAPI ever
        # saw it — attachments looked broken on the server while working locally
        # against the Vite dev server, which talks to the API directly.
        #
        # 12m, not 10m: leave room for multipart overhead so the size limit is
        # enforced in ONE place — the backend, which answers in Vietnamese with
        # the actual file size.
        client_max_body_size 12m;

        proxy_pass ${API_URL};
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Sitemap do BACKEND sinh: danh sách hồ sơ công khai thay đổi mỗi lần có người đăng ký,
    # nên không thể là file tĩnh nằm trong ảnh Docker. `robots.txt` thì ngược lại — tĩnh,
    # nằm ở `public/`, và rơi vào `location /` như mọi file khác.
    location = /sitemap.xml {
        proxy_pass ${API_URL}/sitemap.xml;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # PHẢI đứng trước khối regex `/{slug}` ngay dưới.
    #
    # nginx duyệt các location regex THEO THỨ TỰ VIẾT và dừng ở cái khớp đầu tiên, mà ba
    # đường này khớp y hệt khuôn một đoạn của `/{slug}`. Thiếu khối này thì bot mở
    # `/home` sẽ bị lái sang endpoint dựng hồ sơ và nhận 404 — trang giới thiệu, thứ DUY
    # NHẤT thật sự cần lên Google, biến mất khỏi chỉ mục.
    #
    # `try_files $uri/index.html` chứ KHÔNG phải `$uri $uri/`: ba đường này có bản HTML
    # dựng sẵn nằm ở `dist/home/index.html` (xem `scripts/prerender.ts`), tức `/home` khớp
    # một THƯ MỤC — và nginx trả 301 sang `/home/` khi khớp thư mục kiểu đó. Chuyển hướng
    # đó không làm hỏng gì nhưng nằm đúng trên đường vào của trang cần lên Google nhất.
    # Vế `/index.html` sau vẫn giữ đường lui về vỏ SPA nếu bước dựng sẵn không chạy.
    location ~ ^/(home|login|register)$ {
        try_files $uri/index.html /index.html;
    }

    # Địa chỉ riêng của freelancer: `/thuthuy`. Đúng MỘT đoạn, không dấu chấm — nên
    # `/assets/...`, `/api/...`, `/robots.txt`, `/favicon.svg` đều không lọt vào đây.
    location ~ ^/[a-zA-Z0-9_-]+$ {
        if ($is_bot) {
            rewrite ^/(.*)$ /internal/render/profile/$1 last;
        }
        try_files $uri $uri/ /index.html;
    }

    # Đích của lệnh rewrite ở trên.
    #
    # `proxy_pass` được tách ra đây thay vì đặt thẳng trong khối `if`: `proxy_pass` có
    # chứa biến sẽ buộc nginx phân giải DNS lúc chạy và đòi thêm chỉ thị `resolver`. Ở đây
    # địa chỉ là chuỗi tĩnh sau khi envsubst thay `${API_URL}`, giống hệt khối `/api/`.
    #
    # `internal` để người ngoài không gọi thẳng được endpoint dựng HTML.
    location ^~ /internal/render/profile/ {
        internal;
        proxy_pass ${API_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }

    # Error pages
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
