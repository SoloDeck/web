server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript;
    gzip_disable "MSIE [1-6]\.";

    location /api/ {
        # Deal attachments (client brief PDFs, scanned contracts) come through
        # here: the built app has no VITE_API_URL, so axios falls back to the
        # same-origin "/api/v1" and every upload is proxied by this block.
        #
        # nginx defaults to 1m. The backend accepts 10m, so without this line
        # anything above 1 MB died on nginx's bare 413 page before FastAPI ever
        # saw it — attachments looked broken on the server while working locally
        # against the Vite dev server, which talks to the API directly.
        #
        # 12m, not 10m: leave room for multipart overhead so the size limit is
        # enforced in ONE place — the backend, which answers in Vietnamese with
        # the actual file size.
        client_max_body_size 12m;

        proxy_pass ${API_URL};
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }

    # Error pages
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
